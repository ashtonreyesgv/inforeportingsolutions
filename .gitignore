# Dependencies installed by npm — never committed, restored via `npm install`
node_modules/

# Local environment variables (secrets) — the real values live in Vercel, not git
.env
.env.local
.env*.local

# Vercel CLI local files
.vercel

# Throwaway local test helper — not part of the site
test-submit.mjs

# Vendor/client file drops — working originals only. These get cleaned up and
# copied into tools/ before going live; the raw versions must never deploy.
client_upload/

# Before/after proof screenshots for client reporting — not part of the site
pdfs/
